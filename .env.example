# ByteVerse Environment Variables Template

NODE_ENV=development
PORT=3000

# MongoDB Atlas Database Connection URI (Mongoose)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/byteverse?retryWrites=true&w=majority
MONGODB_URI=

# Administrator Credentials
ADMIN_EMAIL=aswinraj@gmail.com
ADMIN_PASSWORD=

# Telegram Bot API for Instant Enquiry Notifications
# Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# Get your numeric chat ID via @userinfobot to obtain TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session Security & Encryption Secret
SESSION_SECRET=

# Public Contact & Brand Reference
PUBLIC_CONTACT_EMAIL=byteverseindia.in@gmail.com
PUBLIC_INSTAGRAM=byteverse.in

# Deployment Host URL
APP_URL=
